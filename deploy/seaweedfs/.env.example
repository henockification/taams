# SeaweedFS stack environment — paste these into the Dokploy Compose app's
# "Environment" tab. Do not commit real values.
#
# IMPORTANT: generate keys with hex/alphanumeric characters only, e.g.
#   openssl rand -hex 10   # access key
#   openssl rand -hex 32   # secret key
# The credentials file is rendered by a shell heredoc at container start, so a
# key containing $ ` " or \ would be mangled.

SEAWEEDFS_ACCESS_KEY=replace-me
SEAWEEDFS_SECRET_KEY=replace-me

# Size at which the master stops writing to a volume and opens a new one.
# 1024 MB keeps individual volume files small and easy to back up.
SEAWEEDFS_VOLUME_SIZE_LIMIT_MB=1024

# Hard cap on a single uploaded object, in MB.
SEAWEEDFS_MAX_FILE_SIZE_MB=256

# CORS origins allowed to call the S3 API from a browser. Only relevant if you
# expose S3 publicly for presigned uploads; narrow it to your frontend origin.
SEAWEEDFS_ALLOWED_ORIGINS=*

# Only set when the S3 port is published through a Dokploy domain AND presigned
# URL signatures fail to verify. Must match the public origin exactly.
# SEAWEEDFS_EXTERNAL_URL=https://storage.example.com
