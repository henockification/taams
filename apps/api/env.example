# Database
DATABASE_URL="postgresql://username:password@localhost:5432/cool_agent_db?schema=public"

# Private Oracle IFMIS integration (server-side only)
IFMIS_ORACLE_USERNAME="your-oracle-username"
IFMIS_ORACLE_PASSWORD="your-oracle-password"
IFMIS_ORACLE_HOST="10.0.0.10"
IFMIS_ORACLE_PORT="1521"
IFMIS_ORACLE_SERVICE_NAME="service-name"
IFMIS_ORACLE_TABLE="TAMS_ATTENDANCE"

# Server
PORT=3012
NODE_ENV=development
# Live production only. Docker/Next always set NODE_ENV=production, so do not use
# NODE_ENV to mark a test host. Leave APP_ENV unset (or development) on test.
# APP_ENV="production"

# HMAC for session and OTP tokens. Optional except when APP_ENV=production.
# AUTH_SECRET="generate-a-long-random-secret"
# BETTER_AUTH_SECRET is accepted as an alias.
# COOKIE_SECURE="true"  # set false on HTTP test hosts

# Testing OTP 424242 when notifications are off. Works on test hosts.
# Do not set this when APP_ENV=production.
ALLOW_MASTER_OTP="true"

# Super admins sign in with the fixed code 424242 instead of an emailed OTP (sign-in only;
# password reset still emails a real code). Works in production. Everyone else gets a real OTP.
# SUPER_ADMIN_FIXED_OTP="true"

# Google OAuth (for Google Sign-in)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Email Configuration (Resend)
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="Tams <noreply@yourdomain.com>"
# Admin email to notify when a new order is placed (optional; if unset, no admin notification is sent)
ADMIN_EMAIL="admin@yourdomain.com"

# App URLs
APP_BASE_URL="http://your-frontend-domain.com"
# Browser origins allowed to call the API. Comma-separate when both www and non-www domains are used.
CORS_ALLOWED_ORIGINS="http://your-frontend-domain.com,http://www.your-frontend-domain.com"

# Storefront public API (`/api/categories-public`, `/api/packages-public*`). Same value as frontend `NEXT_PUBLIC_STOREFRONT_API_KEY`.
STOREFRONT_API_KEY="generate-a-long-random-secret"

# Object storage (SeaweedFS, S3-compatible)
# S3_ENDPOINT is the in-cluster address; on Dokploy this is the compose service
# name, reachable because both stacks share `dokploy-network`.
S3_ENDPOINT="http://seaweedfs:8333"
S3_ACCESS_KEY_ID="same-value-as-SEAWEEDFS_ACCESS_KEY"
S3_SECRET_ACCESS_KEY="same-value-as-SEAWEEDFS_SECRET_KEY"
S3_BUCKET="taams"
S3_REGION="us-east-1"
# SeaweedFS serves buckets path-style; leave unset unless using a provider that
# requires virtual-hosted-style addressing.
S3_FORCE_PATH_STYLE="true"
# Only needed if the browser hits storage directly via presigned URLs.
# S3_PUBLIC_ENDPOINT="https://storage.example.com"

# Cloudflare R2 Configuration (unused - superseded by the S3_* settings above)
R2_ENDPOINT_URL="https://your-account-id.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="your-bucket-name"

# Add other environment variables as needed

# Workflow notifications
# Master kill switch. Required to be true on the live production host (OTP delivery must work).
# On a test host, keep this false and set ALLOW_MASTER_OTP=true to use 424242.
NOTIFICATIONS_ENABLED="false"
NOTIFICATIONS_EMAIL_ENABLED="false"
NOTIFICATIONS_SMS_ENABLED="false"

# Microsoft Graph email provider (required when email notifications are enabled)
MS_GRAPH_TENANT_ID="your-tenant-id"
MS_GRAPH_CLIENT_ID="your-client-id"
MS_GRAPH_CLIENT_SECRET="your-client-secret"
MS_GRAPH_SENDER_MAILBOX="notifications@yourdomain.com"
MS_GRAPH_SAVE_TO_SENT_ITEMS="false"

# SMS gateway (required on the API when SMS notifications are enabled).
# The API posts to the internal sms-gateway service (npm run worker:sms / Docker target sms-gateway).
SMS_GATEWAY_URL="http://sms-gateway:3090"
SMS_GATEWAY_TOKEN="generate-a-long-random-shared-secret"
# SMS_GATEWAY_TIMEOUT_MS="15000"

# sms-gateway service only: Ethio telecom SMPP account.
# Run exactly one gateway, on the host that owns the LAN IP Ethio telecom whitelisted.
SMS_GATEWAY_PORT="3090"
SMPP_HOST="smsc-ip-from-ethio-telecom"
SMPP_PORT="2775"
SMPP_SYSTEM_ID="your-system-id"
SMPP_PASSWORD="your-smpp-password"
SMPP_SYSTEM_TYPE=""
# TRX (transceiver, receives delivery receipts) or TX (transmit only)
SMPP_BIND_MODE="TRX"
# Short code / sender shown to recipients, and its TON/NPI as given by Ethio telecom
SMPP_SOURCE_ADDR="your-short-code"
SMPP_SOURCE_TON="0"
SMPP_SOURCE_NPI="1"
SMPP_ENQUIRE_LINK_MS="30000"
SMPP_MAX_TPS="10"
SMPP_SUBMIT_TIMEOUT_MS="10000"
SMPP_REGISTERED_DELIVERY="false"
# Source IP to bind the SMPP socket to when the host has several addresses (the reserved LAN IP)
# SMPP_LOCAL_ADDRESS="10.x.x.x"

# Biometric enrollment sync (ZKTeco ADMS). Devices point their "Cloud Server Setting" at this API
# (Server Mode ADMS, HTTPS off, port mapped to the API) and poll /iclock/* for commands.
# Commands (user/template writes) are only sent when this is "true" AND the device has
# "Enrollment sync" enabled; otherwise /iclock replies exactly as before. Punches stay on TCP pull.
ZK_ADMS_COMMANDS_ENABLED="false"
# AES-256-GCM key for stored face/palm templates: 32 bytes as 64 hex chars (openssl rand -hex 32).
# Keep it stable: templates stored with one key cannot be read with another.
BIOMETRIC_TEMPLATE_KEY=""
# Queue removal from all devices when an employee is deactivated in TAAMS.
# ZK_AUTO_REMOVE_ON_DEACTIVATE="false"
# Commands handed to a device per poll (default 100).
# ZK_ADMS_COMMAND_BATCH="100"
# Log every /iclock request (body preview, templates redacted) to confirm the firmware's push dialect.
# ZK_ADMS_DEBUG="false"
