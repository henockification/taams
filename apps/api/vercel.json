{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "app/api/[...route]/route.ts": {
      "includeFiles": "node_modules/source-map/**"
    }
  },
  "build": {
    "env": {
      "NEXT_PRIVATE_STANDALONE": "true"
    }
  }
}
